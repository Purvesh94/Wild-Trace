# ─── Tadoba Sentinel — Environment Variables ──────────────────────────────────
#
# Copy this file to .env and fill in real values.
# Never commit .env to source control.
#
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
# All others are server-side only.

# ── Google Maps (optional) ────────────────────────────────────────────────────
# Required only if you switch MapPanel to use the Google Maps JavaScript API.
# The current implementation uses Leaflet + OpenStreetMap (no key needed).
# Authorise this key for: Maps JavaScript API, restricted to your domain.
# https://developers.google.com/maps/documentation/javascript/get-api-key
VITE_GOOGLE_MAPS_API_KEY=

# ── Local device gateway ─────────────────────────────────────────────────────
# URL of the local Node.js gateway (backend/src/server.js).
# Default: http://127.0.0.1:3099  (localhost only; commands require operator token)
# VITE_DISCOVERY_HELPER_URL=http://127.0.0.1:3099
# VITE_GATEWAY_URL=http://127.0.0.1:3099

# ── Notes on phone GPS over LAN ───────────────────────────────────────────────
# Browsers restrict Geolocation to secure contexts (https:// or localhost).
# On a phone connected to the same LAN:
#   Option 1 (recommended): Serve the frontend with a self-signed TLS cert.
#              Run: npx vite --https   (uses a dev cert; accept in browser)
#   Option 2: Access the dev server via http://localhost:5173 with port-forward
#              (adb reverse, ngrok, etc.) so it resolves as localhost on device.
#   Option 3: Add a LAN cert trusted by the phone (mkcert, local CA).
# Plain http:// on a non-localhost LAN address will silently block GPS.
