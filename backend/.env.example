# Copy to .env.local. Keep this file on your laptop; never commit secrets.
# Use a random, long token and enter the same operator token in Settings.
OPERATOR_TOKEN=REPLACE_WITH_RANDOM_OPERATOR_TOKEN
# Copy the DEVICE_COMMAND_TOKEN from firmware/esp32-drone-controller/secrets.h.
ESP32_COMMAND_TOKEN=REPLACE_WITH_FIRMWARE_DEVICE_COMMAND_TOKEN
